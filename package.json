{
  "name": "eosc-widgets-ruby",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "esbuild app/assets/javascript/application.js --bundle --minify --outdir=tmp/assets",
    "build:css": "sass app/assets/stylesheets/application.scss tmp/assets/application.css --load-path=node_modules",
    "watch": "esbuild app/assets/javascript/application.js --bundle --outdir=tmp/assets --watch",
    "dev": "nodemon --watch tmp/assets --exec 'echo Assets updated'"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/stimulus-webpack-helpers": "^1.0.1",
    "@hotwired/turbo": "^8.0.20",
    "@popperjs/core": "^2.11.8",
    "@rolemodel/turbo-confirm": "^2.2.0",
    "bootstrap": "^5.3.8",
    "bootstrap-datepicker": "^1.10.1",
    "sass-loader": "^16.0.6",
    "trix": "^2.1.16"
  },
  "private": true,
  "devDependencies": {
    "esbuild": "^0.27.2",
    "sass": "^1.97.2"
  }
}
