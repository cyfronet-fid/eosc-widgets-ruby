<div class="container mt-4">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h2 class="h4 mb-0">User Profile</h2>
        </div>
        <div class="card-body">
          <input type="hidden" data-color-target="color">
          <div class="mb-4">
            <h5 class="text-muted border-bottom pb-2">User Information</h5>
            <div class="row mb-2">
              <div class="col-sm-3 font-weight-bold">Full Name:</div>
              <div class="col-sm-9"><%= current_user.first_name %> <%= current_user.last_name %></div>
            </div>
            <div class="row mb-2">
              <div class="col-sm-3 font-weight-bold">Email:</div>
              <div class="col-sm-9"><%= current_user.email %></div>
            </div>
          </div>

          <% @auth_data.each do |provider, data| %>
            <div class="mb-4 shadow-sm p-3 mb-3 bg-light rounded">
              <h5 class="text-muted border-bottom pb-2">
                Authentication: <span class="badge bg-info"><%= provider %></span>
                <% if provider.to_s == session[:identity_provider_slug] %>
                  <span class="badge bg-success ms-2">Current</span>
                <% end %>
              </h5>
              <div class="row mb-2">
                <div class="col-sm-3 font-weight-bold">UID:</div>
                <div class="col-sm-9">
                  <code><%= (data[:uid] || data['uid']) if data %></code>
                </div>
              </div>
              <div class="row mb-2">
                <div class="col-sm-3 font-weight-bold">Access Token:</div>
                <div class="col-sm-9">
                  <div class="text-break" data-controller="profile">
                    <% token = data[:access_token] || data['access_token'] if data %>
                    <% if token %>
                      <div class="input-group">
                        <input type="password" id="accessToken-<%= provider %>" class="form-control font-monospace" value="<%= token %>" readonly data-profile-target="input">
                        <button class="btn btn-outline-secondary" type="button" id="toggleToken-<%= provider %>" data-profile-target="toggleButton" data-action="click->profile#toggle">Show</button>
                        <button class="btn btn-outline-primary" type="button" id="copyToken-<%= provider %>" data-action="click->profile#copy">Copy</button>
                      </div>
                      <small data-profile-target="copyMessage" class="text-success d-none">Token copied to clipboard!</small>
                    <% else %>
                      <span class="text-danger italic">Not available in current session.</span>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <% if @auth_data.empty? %>
            <div class="alert alert-warning">
              No authentication data found in session.
            </div>
          <% end %>

          <div class="mt-4">
            <a href="/" class="btn btn-secondary">Back to Home</a>
            <a href="/favourites" class="btn btn-primary">My Favourites</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
