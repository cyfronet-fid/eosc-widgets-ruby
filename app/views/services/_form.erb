<form action="<%= @service.new_record? ? '/services' : "/services/#{@service.id}" %>" method="post" class="card card-body">
  <% unless @service.new_record? %>
    <input type="hidden" name="_method" value="put">
  <% end %>

  <div class="mb-3">
    <label for="service_name" class="form-label">Name</label>
    <input type="text" name="service[name]" id="service_name" class="form-control" value="<%= @service.name %>" required>
  </div>

  <div class="mb-3">
    <label for="service_abbr" class="form-label">Abbreviation</label>
    <input type="text" name="service[abbreviation]" id="service_abbr" class="form-control" value="<%= @service.abbreviation %>">
  </div>

  <div class="mb-3">
    <label for="service_pid" class="form-label">PID</label>
    <input type="text" name="service[pid]" id="service_pid" class="form-control" value="<%= @service.pid %>">
  </div>

  <div class="mb-3">
    <label for="service_url" class="form-label">URL</label>
    <input type="url" name="service[url]" id="service_url" class="form-control" value="<%= @service.url %>" required>
  </div>

  <div class="mb-3">
    <label for="service_idp" class="form-label">Identity Provider</label>
    <select name="service[identity_provider_id]" id="service_idp" class="form-select" required>
      <option value="">Select Identity Provider...</option>
      <% @identity_providers.each do |idp| %>
        <option value="<%= idp.id %>" <%= 'selected' if @service.identity_provider_id == idp.id %>>
          <%= idp.name %>
        </option>
      <% end %>
    </select>
  </div>

  <div class="d-flex justify-content-between">
    <a href="/services" class="btn btn-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><%= @service.new_record? ? 'Create' : 'Update' %> Service</button>
  </div>
</form>
