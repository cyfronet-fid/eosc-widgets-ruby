<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Endpoints</h2>
  <a href="/endpoints/new" class="btn btn-success">Add Endpoint</a>
</div>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Name</th>
      <th>Abbreviation</th>
      <th>PID</th>
      <th>URL</th>
      <th>Identity Provider</th>
      <th>Created At</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @endpoints.each do |endpoint| %>
      <% 
        is_favourite = false
        if signed_in?
          is_favourite = current_user.favourites.exists?(pid: endpoint.pid, type: 'Endpoint')
        end
      %>
      <tr>
        <td><%= endpoint.name %></td>
        <td><%= endpoint.abbreviation %></td>
        <td><%= endpoint.pid %></td>
        <td><a href="<%= endpoint.url %>" target="_blank"><%= endpoint.url %></a></td>
        <td><%= endpoint.identity_provider&.name %></td>
        <td><%= endpoint.created_at.strftime("%Y-%m-%d %H:%M") %></td>
        <td>
          <div class="d-flex gap-2">
            <a href="/endpoints/<%= endpoint.slug || endpoint.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
              
            <% if signed_in? %>
              <% if is_favourite %>
                <form action="/api/favourites" method="post" class="d-inline">
                  <input type="hidden" name="_method" value="delete">
                  <input type="hidden" name="pid" value="<%= endpoint.pid %>">
                  <input type="hidden" name="type" value="Service">
                  <button type="submit" class="btn btn-sm btn-warning" title="Remove from favourites">★</button>
                </form>
              <% else %>
                <form action="/api/favourites" method="post" class="d-inline">
                  <input type="hidden" name="favourite[pid]" value="<%= endpoint.pid %>">
                  <input type="hidden" name="favourite[type]" value="Service">
                  <input type="hidden" name="favourite[title]" value="<%= endpoint.name %>">
                  <input type="hidden" name="favourite[links][]" value="<%= endpoint.url %>">
                  <button type="submit" class="btn btn-sm btn-outline-warning" title="Add to favourites">☆</button>
                </form>
              <% end %>
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>
    <% if @endpoints.empty? %>
      <tr>
        <td colspan="7" class="text-center">No endpoints found.</td>
      </tr>
    <% end %>
  </tbody>
</table>
