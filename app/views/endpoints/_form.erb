<form action="<%= @endpoint.new_record? ? '/endpoints' : "/endpoints/#{@endpoint.id}" %>" method="post" class="card card-body">
  <% unless @endpoint.new_record? %>
    <input type="hidden" name="_method" value="put">
  <% end %>

  <div class="mb-3">
    <label for="endpoint_name" class="form-label">Name</label>
    <input type="text" name="endpoint[name]" id="endpoint_name" class="form-control" value="<%= @endpoint.name %>" required>
  </div>

  <div class="mb-3">
    <label for="endpoint_abbr" class="form-label">Abbreviation</label>
    <input type="text" name="endpoint[abbreviation]" id="endpoint_abbr" class="form-control" value="<%= @endpoint.abbreviation %>">
  </div>

  <div class="mb-3">
    <label for="endpoint_pid" class="form-label">PID</label>
    <input type="text" name="endpoint[pid]" id="endpoint_pid" class="form-control" value="<%= @endpoint.pid %>">
  </div>

  <div class="mb-3">
    <label for="endpoint_url" class="form-label">URL</label>
    <input type="url" name="endpoint[url]" id="endpoint_url" class="form-control" value="<%= @endpoint.url %>" required>
  </div>

  <div class="mb-3">
    <label for="endpoint_idp" class="form-label">Identity Provider</label>
    <select name="endpoint[identity_provider_id]" id="endpoint_idp" class="form-select" required>
      <option value="">Select Identity Provider...</option>
      <% @identity_providers.each do |idp| %>
        <option value="<%= idp.id %>" <%= 'selected' if @endpoint.identity_provider_id == idp.id %>>
          <%= idp.name %>
        </option>
      <% end %>
    </select>
  </div>

  <div class="d-flex justify-content-between">
    <a href="/endpoints" class="btn btn-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><%= @endpoint.new_record? ? 'Create' : 'Update' %> Endpoint</button>
  </div>
</form>
